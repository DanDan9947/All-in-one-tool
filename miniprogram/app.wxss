page {
  background: #f5f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  padding: 36rpx 32rpx 64rpx;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(34, 60, 100, 0.08);
}

.primary-button {
  margin-top: 28rpx;
  border: 0;
  border-radius: 18rpx;
  background: #3867f4;
  color: #fff;
  font-weight: 600;
}

.secondary-button {
  margin-top: 20rpx;
  border: 2rpx solid #dce3f0;
  border-radius: 18rpx;
  background: #fff;
  color: #27334d;
}

.preview {
  width: 100%;
  max-height: 720rpx;
  border-radius: 20rpx;
  margin-top: 24rpx;
}

.hint {
  color: #74809a;
  font-size: 26rpx;
  line-height: 1.7;
}

