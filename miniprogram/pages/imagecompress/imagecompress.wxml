<view class="page">
  <view class="card">
    <text class="section-title">选择需要压缩的图片</text>
    <text class="hint">支持 JPG、PNG、WebP，单张不超过 50MB</text>
    <image wx:if="{{imagePath}}" class="preview" src="{{imagePath}}" mode="aspectFit" />
    <button class="secondary-button" bindtap="chooseImage">{{imagePath ? '重新选择' : '拍照或选择图片'}}</button>
    <view wx:if="{{imagePath}}" class="preset-grid">
      <button class="preset {{preset === 'small' ? 'selected' : ''}}" data-preset="small" bindtap="selectPreset">小体积<text>最长边 1600px</text></button>
      <button class="preset {{preset === 'balanced' ? 'selected' : ''}}" data-preset="balanced" bindtap="selectPreset">均衡<text>推荐日常使用</text></button>
      <button class="preset {{preset === 'high' ? 'selected' : ''}}" data-preset="high" bindtap="selectPreset">高清<text>保持原尺寸</text></button>
      <button class="preset {{preset === 'custom' ? 'selected' : ''}}" data-preset="custom" bindtap="selectPreset">目标大小<text>按 KB 压缩</text></button>
    </view>
    <view class="quick-target-panel">
      <view class="quick-target-heading">
        <text>常用目标大小</text>
        <text>适合报名、证件和办公系统上传</text>
      </view>
      <view class="quick-target-options">
        <button class="quick-target {{preset === 'custom' && targetSizeKb === '200' ? 'selected' : ''}}" data-size="200" bindtap="selectTargetSize">200KB</button>
        <button class="quick-target {{preset === 'custom' && targetSizeKb === '500' ? 'selected' : ''}}" data-size="500" bindtap="selectTargetSize">500KB</button>
        <button class="quick-target {{preset === 'custom' && targetSizeKb === '1024' ? 'selected' : ''}}" data-size="1024" bindtap="selectTargetSize">1MB</button>
      </view>
    </view>
    <input wx:if="{{preset === 'custom'}}" class="target-input" type="number" placeholder="目标大小，例如 500KB" value="{{targetSizeKb}}" bindinput="onTargetInput" />
    <button wx:if="{{imagePath}}" class="primary-button compress-button" loading="{{loading}}" disabled="{{loading}}" bindtap="compress">开始压缩</button>
  </view>
  <view wx:if="{{result}}" class="card result-card">
    <text class="section-title">压缩完成</text>
    <image class="result-image" src="{{result.path}}" mode="aspectFit" />
    <view class="size-row"><text>{{originalSizeText}}</text><text>→</text><text>{{outputSizeText}}</text></view>
    <text class="hint result-hint">{{resultHint}}</text>
    <button class="primary-button compress-button" bindtap="saveResult">保存到相册</button>
  </view>
</view>
