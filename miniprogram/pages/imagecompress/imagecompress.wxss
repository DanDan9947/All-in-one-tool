.section-title{display:block;margin-bottom:12rpx;font-size:34rpx;font-weight:700}.preset-grid{margin-top:24rpx;display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.preset{min-height:112rpx;padding:18rpx!important;display:flex;flex-direction:column;align-items:flex-start!important;border:2rpx solid #e0e5ee!important;border-radius:18rpx!important;background:#fff!important;color:#172035!important;font-size:27rpx!important;font-weight:700!important}.preset text{margin-top:6rpx;color:#8c94a3;font-size:20rpx;font-weight:400}.preset.selected{border-color:#2b67d1!important;background:#eef4ff!important;color:#2b67d1!important}.quick-target-panel{margin-top:18rpx;padding:20rpx;border:2rpx solid #d9e4fa;border-radius:18rpx;background:#f6f9ff}.quick-target-heading{display:flex;flex-direction:column;gap:5rpx}.quick-target-heading text:first-child{font-size:25rpx;font-weight:700}.quick-target-heading text:last-child{color:#8c94a3;font-size:20rpx}.quick-target-options{margin-top:16rpx;display:flex;gap:12rpx}.quick-target{min-width:0!important;margin:0!important;padding:0 24rpx!important;border:2rpx solid #cddaf3!important;border-radius:999rpx!important;color:#2b67d1!important;background:#fff!important;font-size:23rpx!important;font-weight:700!important;line-height:62rpx!important}.quick-target.selected{border-color:#2b67d1!important;color:#fff!important;background:#2b67d1!important}.target-input{margin-top:18rpx;padding:22rpx;border:2rpx solid #dfe4ed;border-radius:16rpx;background:#fafbfc}.compress-button{background:#2b67d1}.result-card{margin-top:28rpx}.result-image{width:100%;height:620rpx;margin-top:16rpx;border-radius:18rpx;background:#f4f6fa}.size-row{margin:24rpx 0;display:flex;justify-content:center;gap:30rpx;font-size:32rpx;font-weight:700}.size-row text:nth-child(2){color:#97a0b1}.result-hint{display:block;text-align:center}
